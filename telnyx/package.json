{
  "name": "@absolutejs/dispatch-telnyx",
  "version": "0.3.0",
  "description": "Production Telnyx SMS, MMS, and RCS messaging for @absolutejs/dispatch with signed webhooks, consent-safe scheduling, registration workflows, and readiness checks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/dispatch-adapters.git",
    "directory": "telnyx"
  },
  "homepage": "https://github.com/absolutejs/dispatch-adapters/tree/main/telnyx",
  "bugs": {
    "url": "https://github.com/absolutejs/dispatch-adapters/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "absolutejs",
    "dispatch",
    "telnyx",
    "sms",
    "mms",
    "rcs",
    "10dlc"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external @absolutejs/compliance --external @absolutejs/dispatch --external '@absolutejs/dispatch/*' --external @absolutejs/reliability --external '@absolutejs/reliability/*' --external @absolutejs/manifest --external @sinclair/typebox --external telnyx --external 'telnyx/*' && tsc --project tsconfig.build.json && absolute-manifest emit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && bun run verify-package --artifacts",
    "release": "bun run check:package && npm publish --access public"
  },
  "peerDependencies": {
    "@absolutejs/compliance": ">=0.7.0 <0.8",
    "@absolutejs/dispatch": ">=0.7.0 <0.8",
    "telnyx": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@absolutejs/compliance": {
      "optional": true
    }
  },
  "dependencies": {
    "@absolutejs/manifest": "0.7.2",
    "@absolutejs/reliability": "0.1.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@absolutejs/compliance": "0.7.0",
    "@absolutejs/dispatch": "0.7.1",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.3",
    "pg": "8.22.0",
    "prettier": "3.8.1",
    "telnyx": "7.12.0",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/compliance": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/compliance"
        ],
        "optional": true,
        "range": ">=0.7.0 <0.8",
        "tested": "0.7.0"
      },
      "@absolutejs/dispatch": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/dispatch",
          "@absolutejs/dispatch/*"
        ],
        "optional": false,
        "range": ">=0.7.0 <0.8",
        "tested": "0.7.1"
      },
      "telnyx": {
        "artifactImports": [],
        "buildExternals": [
          "telnyx",
          "telnyx/*"
        ],
        "optional": false,
        "range": ">=7.0.0 <8",
        "tested": "7.12.0"
      }
    }
  }
}
