{
  "name": "@absolutejs/dispatch-vonage",
  "version": "0.2.0",
  "description": "Production Vonage Messages API adapter for AbsoluteJS with multichannel failover, signed durable webhooks, consent, readiness, and 10DLC inspection.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/dispatch-adapters.git",
    "directory": "vonage"
  },
  "homepage": "https://github.com/absolutejs/dispatch-adapters/tree/main/vonage",
  "bugs": {
    "url": "https://github.com/absolutejs/dispatch-adapters/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "absolutejs",
    "dispatch",
    "vonage",
    "sms",
    "mms",
    "rcs",
    "whatsapp",
    "viber"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external @absolutejs/compliance --external @absolutejs/dispatch --external '@absolutejs/dispatch/*' --external @absolutejs/reliability --external '@absolutejs/reliability/*' --external @absolutejs/manifest --external @sinclair/typebox --external @vonage/server-sdk --external '@vonage/*' && tsc --project tsconfig.build.json && absolute-manifest emit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && bun run verify-package --artifacts",
    "release": "bun run check:package && npm publish --access public"
  },
  "peerDependencies": {
    "@absolutejs/compliance": ">=0.7.0 <0.8",
    "@absolutejs/dispatch": ">=0.7.0 <0.8",
    "@vonage/server-sdk": ">=3.29.0 <4"
  },
  "peerDependenciesMeta": {
    "@absolutejs/compliance": {
      "optional": true
    }
  },
  "dependencies": {
    "@absolutejs/manifest": "0.7.2",
    "@absolutejs/reliability": "0.1.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@absolutejs/compliance": "0.7.0",
    "@absolutejs/dispatch": "0.7.1",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.3",
    "@vonage/server-sdk": "3.29.0",
    "pg": "8.22.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/compliance": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/compliance"
        ],
        "optional": true,
        "range": ">=0.7.0 <0.8",
        "tested": "0.7.0"
      },
      "@absolutejs/dispatch": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/dispatch",
          "@absolutejs/dispatch/*"
        ],
        "optional": false,
        "range": ">=0.7.0 <0.8",
        "tested": "0.7.1"
      },
      "@vonage/server-sdk": {
        "artifactImports": [],
        "buildExternals": [
          "@vonage/server-sdk",
          "@vonage/*"
        ],
        "optional": false,
        "range": ">=3.29.0 <4",
        "tested": "3.29.0"
      }
    }
  }
}
