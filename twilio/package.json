{
  "name": "@absolutejs/dispatch-twilio",
  "version": "0.4.0",
  "description": "Production Twilio SMS, MMS, RCS, and WhatsApp for @absolutejs/dispatch with consent enforcement, signed webhooks, registration automation, and readiness checks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/dispatch-adapters.git",
    "directory": "twilio"
  },
  "homepage": "https://github.com/absolutejs/dispatch-adapters/tree/main/twilio",
  "bugs": {
    "url": "https://github.com/absolutejs/dispatch-adapters/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dispatch",
    "sms",
    "rcs",
    "a2p-10dlc",
    "twilio",
    "absolutejs",
    "transactional"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external @absolutejs/compliance --external @absolutejs/dispatch --external '@absolutejs/dispatch/*' --external @absolutejs/manifest --external @sinclair/typebox --external twilio --external 'twilio/*' && tsc --project tsconfig.build.json && absolute-manifest emit",
    "test": "bun test",
    "test:postgres": "bun test tests/twilioPostgres.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && bun run verify-package --artifacts",
    "release": "bun run check:package && npm publish --access public"
  },
  "peerDependencies": {
    "@absolutejs/compliance": ">=0.4.0 <0.5",
    "@absolutejs/dispatch": ">=0.4.0 <0.5",
    "twilio": ">=5.0.0 <7"
  },
  "devDependencies": {
    "@absolutejs/compliance": "0.4.0",
    "@absolutejs/dispatch": "0.4.0",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.3",
    "pg": "8.22.0",
    "prettier": "3.8.1",
    "twilio": "6.0.2",
    "typescript": "5.8.3"
  },
  "peerDependenciesMeta": {
    "@absolutejs/compliance": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/compliance": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/compliance"
        ],
        "optional": true,
        "range": ">=0.4.0 <0.5",
        "tested": "0.4.0"
      },
      "@absolutejs/dispatch": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/dispatch",
          "@absolutejs/dispatch/*"
        ],
        "optional": false,
        "range": ">=0.4.0 <0.5",
        "tested": "0.4.0"
      },
      "twilio": {
        "artifactImports": [],
        "buildExternals": [
          "twilio",
          "twilio/*"
        ],
        "optional": false,
        "range": ">=5.0.0 <7",
        "tested": "6.0.2"
      }
    }
  },
  "dependencies": {
    "@absolutejs/manifest": "0.7.2",
    "@sinclair/typebox": "^0.34.0"
  }
}
